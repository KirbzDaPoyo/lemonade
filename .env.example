EXPO_PUBLIC_PLACE_SEARCH_PROVIDER=mock
EXPO_PUBLIC_INSTAGRAM_IMPORT_PROVIDER=apify
EXPO_PUBLIC_DEFAULT_SEARCH_REGION=HK
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_RELEASE_CHANNEL=development

# Platform-restricted native client keys, distinct from the server Places key.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Use mock for synthetic, cost-free positions; real uses authenticated place-locations.
EXPO_PUBLIC_MAP_RESOLVER=real
# Server only, downward overrides; configure only with deployment authorization:
# MAP_USER_DAILY_LIMIT=60
# MAP_PROJECT_DAILY_LIMIT=250

# Sharing backend only. Keep out of Expo public variables and browser bundles.
# Configure Supabase secrets only after deployment authorization.
# SHARING_ENABLED=false
# SHARING_ALLOWED_ORIGINS=https://your-approved-sharing-host
# SHARING_TOKEN_ENCRYPTION_KEYS={"v1":"<32 random bytes encoded as unpadded base64url>"}
# SHARING_ACTIVE_KEY_ID=v1
# Downward-only limits. Each endpoint scope has independent counters.
# SHARING_MINUTE_LIMIT=120
# SHARING_DAILY_LIMIT=5000

# Release 0.9: approved HTTPS recipient origin only; leave blank until the public page is deployed.
EXPO_PUBLIC_SHARING_ORIGIN=

# Package F: generate association files only after verifying real domain/signing identities.
# SHARING_APP_LINKS_ENABLED=true
# SHARING_ANDROID_SHA256=<verified release SHA-256 fingerprint; comma-separated if needed>
# SHARING_IOS_APP_ID=<verified Apple Team ID>.<matching bundle ID>
# LEMONADE_NATIVE_SHARING_SCHEME=project-lemonade
