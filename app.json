{
  "expo": {
    "name": "Project Lemonade",
    "slug": "project-lemonade",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "project-lemonade",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d6fa64ff-1623-4776-b302-9ccde3aae84d"
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/plain"
          ]
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "@clerk/expo",
      "expo-font",
      "expo-router",
      "expo-localization",
      [
        "@sentry/react-native",
        {
          "organization": "land-of-poyo",
          "project": "project-lemonade",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projectlemonade.mvp"
    },
    "android": {
      "package": "com.projectlemonade.mvp"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "d6fa64ff-1623-4776-b302-9ccde3aae84d"
      }
    }
  }
}
